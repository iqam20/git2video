{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/git2video/git2video/main/skills/git2video/references/storyboard.schema.json",
  "title": "git2video storyboard",
  "description": "Documented contract for storyboard.json. validate.mjs implements these rules without a runtime dependency; render.mjs consumes the file.",
  "type": "object",
  "required": ["meta", "scenes"],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["repo", "label"],
      "properties": {
        "repo": { "type": "string", "minLength": 1, "maxLength": 80 },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "theme": { "enum": ["dark", "light", "neon"] },
        "preset": { "enum": ["16:9", "9:16", "1:1"] },
        "fps": { "enum": [30, 60] }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" },
      "description": "ordered. first.type=title and last.type=outro (validated by validate.mjs). total duration 15-75s by default."
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["id", "type", "duration", "source", "data"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["title", "highlights", "diff", "stats", "timeline", "breaking", "contributors", "outro"] },
        "duration": { "type": "number", "minimum": 0.8, "maximum": 15 },
        "narration": {
          "type": "string",
          "description": "<= 2 sentences; reading-time rule 0.35s/word + 0.5s within the scene duration. burned as captions."
        },
        "source": {
          "type": "string",
          "description": "commit shas backing the scene's claims; with --story each sha must exist in story.json."
        },
        "data": { "oneOf": [ { "$ref": "#/$defs/title" }, { "$ref": "#/$defs/highlights" }, { "$ref": "#/$defs/diff" }, { "$ref": "#/$defs/stats" }, { "$ref": "#/$defs/timeline" }, { "$ref": "#/$defs/breaking" }, { "$ref": "#/$defs/contributors" }, { "$ref": "#/$defs/outro" } ] }
      }
    },
    "title": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "repo": { "type": "string", "maxLength": 80 },
        "tagline": { "type": "string", "maxLength": 120 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "highlights": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["type", "text"],
            "properties": {
              "type": { "enum": ["feat", "fix", "perf", "removed", "docs", "tests", "build", "changed"] },
              "text": { "type": "string", "minLength": 3, "maxLength": 160 }
            }
          }
        }
      }
    },
    "diff": {
      "type": "object",
      "required": ["file", "sha", "code"],
      "properties": {
        "file": { "type": "string", "maxLength": 200 },
        "sha": { "type": "string", "minLength": 7 },
        "code": { "type": "string", "description": "<= 18 lines, each <= 72 chars, no ---/+++ header lines" }
      }
    },
    "stats": {
      "type": "object",
      "required": ["commits"],
      "properties": {
        "commits": { "type": "number", "minimum": 0 },
        "files": { "type": "number", "minimum": 0 },
        "additions": { "type": "number", "minimum": 0 },
        "deletions": { "type": "number", "minimum": 0 },
        "contributors": { "type": "number", "minimum": 0 }
      }
    },
    "timeline": {
      "type": "object",
      "required": ["points"],
      "properties": {
        "points": {
          "type": "array", "minItems": 2, "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["date", "label"],
            "properties": {
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "label": { "type": "string", "minLength": 2, "maxLength": 60 }
            }
          }
        }
      }
    },
    "breaking": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["summary"],
            "properties": {
              "summary": { "type": "string", "minLength": 3, "maxLength": 120 },
              "action": { "type": "string", "maxLength": 120 }
            }
          }
        }
      }
    },
    "contributors": {
      "type": "object",
      "required": ["names"],
      "properties": {
        "names": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 60 } }
      }
    },
    "outro": {
      "type": "object",
      "properties": {
        "headline": { "type": "string", "maxLength": 80 },
        "cmd": { "type": "string", "maxLength": 80 },
        "url": { "type": "string", "maxLength": 80 }
      }
    }
  }
}
